{
  "name": "srk-team-star",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node tools/build-web-assets.js --check && node tools/verify-vercel-public.js",
    "build:images": "node tools/optimize-local-images.js",
