# Secrets. backend/.env holds the Supabase service-role key and the Razorpay
# secrets; it must never be committed. PRIVATE_PATH already refuses to serve
# it, and this is the other half of that.
backend/.env
backend/.env.*
!backend/.env.example

# Installed, not authored.
node_modules/

# Operator output: reconciliation reports and the lock that serialises them.
backend/logs/

# Playwright's own artefacts.
backend/test-results/
backend/playwright-report/
backend/blob-report/
test-results/
playwright-report/

# Vercel's local project metadata. The root public/ directory is authored and
# committed because Vercel serves that directory through its CDN.
/.vercel/

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
