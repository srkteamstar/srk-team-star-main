# =============================================================================
# backend/.env.example — every variable this server reads
# =============================================================================
#
# Copy to backend/.env and fill in the real values. This file carries NO real
# values and is safe to commit; .env is git-ignored and must never be.
#
# Not served: /backend/* is answered 404 by the PRIVATE_PATH middleware in
# server.js before the static handler sees it, and dotfiles are ignored on top
# of that.
# =============================================================================


# ---- Required ---------------------------------------------------------------

# The port this process serves the API *and* the whole site on.
PORT=3000

# Supabase project. The URL is not a secret — it appears in every product
# image URL the API returns, so it is public by construction.
SUPABASE_URL=https://your-project-ref.supabase.co

# THE most sensitive value here. Bypasses every row-level security policy in
# the database. Server only, never in a browser, never in git.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the session cookie. Minimum 32 characters — the process refuses to
# start with anything shorter. Generate one, do not invent one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=


# ---- Payments (Razorpay) ----------------------------------------------------
#
# ALL FOUR OR NONE. With PAYMENTS_ENABLED set, the other three must be present
# and the key must match the environment, or the process refuses to start —
# see assertBootConfig() in src/razorpay.js. That refusal is deliberate: the
# alternative is a storefront that takes orders it cannot charge for.
#
# Leave PAYMENTS_ENABLED unset (or remove it) to run the offline flow, which is
# what this site did before the gateway existed: orders are recorded with a
# Pending payment for the sales team to settle.

# 1, true, yes or on. Anything else — including absent — means off.
# PAYMENTS_ENABLED=1

# NOT A SECRET. This is handed to the browser so Razorpay's modal can open;
# it is designed to be public. Dashboard -> Settings -> API Keys.
# Starts rzp_test_ in test mode, rzp_live_ in live mode. The server refuses to
# boot on a test key under NODE_ENV=production, and on a live key outside it.
RAZORPAY_KEY_ID=

# SECRET. Issued alongside the key id, shown ONCE at generation — if you did
# not save it, regenerate the pair. Authenticates API calls and signs the
# checkout callback.
RAZORPAY_KEY_SECRET=

# SECRET, AND A DIFFERENT ONE. This is the value most people trip over: it is
# not issued to you. You invent it and type it into the webhook form at
# Dashboard -> Settings -> Webhooks, then paste the same string here. It signs
# webhook deliveries and nothing else.
#
# Generate it the same way as SESSION_SECRET rather than choosing one.
# Subscribe the webhook to: payment.captured, payment.failed, order.paid,
# refund.processed.
RAZORPAY_WEBHOOK_SECRET=


# ---- Optional. Both default to the safe answer when unset. ------------------

# Number of reverse proxies in front of this process. LEAVE UNSET unless there
# genuinely is one. It was once hardcoded to 1 with nothing proxying, which
# made X-Forwarded-For client-controlled — and every rate limiter keys on the
# IP it produces, so one header per request reset the count and rate limiting
# silently did nothing. Set to 1 behind a single nginx / Cloudflare / Render.
# TRUST_PROXY=1

# Comma-separated origins allowed to make credentialed cross-origin calls.
# LEAVE UNSET when this process serves the site itself, which it does: the
# browser's own requests are same-origin and need no CORS grant at all.
# ALLOWED_ORIGINS=https://www.srkteamstar.com

# Optional HTTPS endpoint for payment/reconciliation alerts. The application
# always writes the same redacted JSON events to platform logs; configuring
# this also forwards them to an alerting service without customer data.
# OPERATIONAL_ALERT_WEBHOOK_URL=https://alerts.example.net/hooks/replace-me

# Confirmed checkout rules. Delivery below the threshold is confirmed and
# collected at delivery, so it is not included in the website payment.
# GST_RATE=0.18
# SHIPPING_FREE_ABOVE=50000

# Set to production for a real deployment. Also gates the Razorpay key-prefix
# check above, and makes the session cookie secure-only.
# NODE_ENV=production
